{
  "schemaVersion": 1,
  "reportSchemaVersion": 1,
  "profileSchemaVersion": 1,
  "contractId": "rp2-opcua-v0.5.2-resource-benchmark",
  "release": "0.5.2",
  "compatibilityBaseline": "2881230c2ccbb98b8701730c4de930dc95da30fc",
  "snapshotPeriodMs": 1000,
  "resultStates": [
    "measured",
    "unsupported",
    "unavailable",
    "exhausted",
    "failed",
    "not-run"
  ],
  "qualityStates": [
    "good",
    "uncertain-last-usable",
    "bad-no-data",
    "bad-not-supported",
    "bad-not-connected"
  ],
  "counterPolicy": {
    "widthBits": 64,
    "valueOverflow": "wrap-to-zero",
    "wrapCountOverflow": "saturate-at-uint64-max",
    "defaultLifetime": "boot",
    "defaultReset": "reboot-only"
  },
  "clockPolicy": {
    "elapsed": "monotonic",
    "wallClock": "record-only-when-device-time-valid",
    "crossClockSubtraction": "forbidden",
    "eventLatency": "requires-correlated-client-receive-and-valid-device-source-timestamp-or-is-unavailable"
  },
  "bounds": {
    "maxProfiles": 192,
    "maxRepetitionsPerProfile": 5,
    "maxWarmupSeconds": 120,
    "maxRunSeconds": 900,
    "operationTimeoutMs": 30000,
    "connectTimeoutMs": 60000,
    "maxRetriesPerOperation": 3,
    "maxOperationSamplesPerMetric": 100000,
    "maxNotificationSamplesPerMetric": 100000,
    "maxPendingCorrelations": 1024,
    "maxHistoryContinuationPointsPerClient": 16,
    "maxErrorsPerRun": 256,
    "maxErrorTextBytes": 256,
    "maxJsonBytes": 8388608
  },
  "requiredSetupMetadata": [
    "schemaVersion",
    "profileSchemaVersion",
    "profileId",
    "firmwareVersion",
    "gitCommit",
    "gitDirty",
    "boardRevision",
    "driverPack",
    "namespaceZero",
    "securityPolicy",
    "securityMode",
    "toolchain",
    "buildType",
    "buildFlags",
    "configuredCapacities",
    "channelCount",
    "samplePeriodMs",
    "publishPeriodMs",
    "clientCount",
    "clientVersions",
    "eventsEnabled",
    "historyEnabled",
    "networkSetup",
    "timeSynchronization",
    "warmupSeconds",
    "durationSeconds",
    "repetitions"
  ],
  "requiredRunAccounting": [
    "operationCount",
    "sampleCount",
    "notificationCount",
    "errorCount",
    "droppedSampleCount",
    "timedOutOperationCount"
  ],
  "metricFamilies": [
    {
      "id": "static_artifacts",
      "scope": "build",
      "metrics": ["ElfFileBytes", "Uf2FileBytes", "BinFileBytes", "ExternalFlashLoadBytes"],
      "owner": "static-size-report",
      "unit": "bytes",
      "kind": "gauge",
      "lifetime": "build-artifact",
      "reset": "new-build",
      "overflow": "reject-report",
      "synchronization": "ELF-map-and-artifact-files-from-one-build",
      "availability": "missing-or-malformed-artifact-is-failed-never-zero",
      "implementationTask": "T1"
    },
    {
      "id": "static_sram",
      "scope": "build",
      "metrics": ["SramDataBytes", "SramBssBytes", "SramStaticTotalBytes", "SramReservedHeapBytes", "SramReservedTaskStackBytes"],
      "owner": "static-size-report",
      "unit": "bytes",
      "kind": "gauge",
      "lifetime": "build-artifact",
      "reset": "new-build",
      "overflow": "reject-report",
      "synchronization": "ELF-map-and-linker-layout-from-one-build",
      "availability": "unknown-reservations-are-unavailable-never-estimated-as-runtime-use",
      "implementationTask": "T1"
    },
    {
      "id": "heap_gauges",
      "scope": "device-snapshot",
      "metrics": ["Heap.TotalBytes", "Heap.UsedBytes", "Heap.PeakUsedBytes", "Heap.FreeBytes", "Heap.MinimumEverFreeBytes", "Heap.LargestFreeBlockBytes", "Heap.SmallestFreeBlockBytes", "Heap.FreeBlockCount", "Heap.LastFailedRequestedBytes", "Heap.LastFailedAdjustedBytes", "Heap.LastFailureReason", "Heap.LastFailureReasonText", "Heap.LastFailureTimestamp", "Heap.LastFailureUptimeMs"],
      "owner": "diag_service/freeRTOS-heap-provider",
      "unit": "mixed",
      "unitByMetric": {"Heap.TotalBytes": "bytes", "Heap.UsedBytes": "bytes", "Heap.PeakUsedBytes": "bytes", "Heap.FreeBytes": "bytes", "Heap.MinimumEverFreeBytes": "bytes", "Heap.LargestFreeBlockBytes": "bytes", "Heap.SmallestFreeBlockBytes": "bytes", "Heap.FreeBlockCount": "blocks", "Heap.LastFailedRequestedBytes": "bytes", "Heap.LastFailedAdjustedBytes": "bytes", "Heap.LastFailureReason": "enum", "Heap.LastFailureReasonText": "text", "Heap.LastFailureTimestamp": "utc-datetime", "Heap.LastFailureUptimeMs": "milliseconds"},
      "kind": "gauge",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "checked-conversion-or-failed",
      "synchronization": "one-second-coherent-diag-service-snapshot",
      "availability": "bad-no-data-before-first-snapshot; stale-is-uncertain-last-usable",
      "implementationTask": "T2"
    },
    {
      "id": "heap_counters",
      "scope": "device-snapshot",
      "metrics": ["Heap.SuccessfulAllocations", "Heap.SuccessfulAllocationsWrapCount", "Heap.SuccessfulFrees", "Heap.SuccessfulFreesWrapCount", "Heap.FailedAllocations", "Heap.FailedAllocationsWrapCount", "Heap.InvalidContextFailures", "Heap.InvalidContextFailuresWrapCount"],
      "owner": "diag_service/freeRTOS-heap-provider",
      "unit": "operations",
      "kind": "wrapping-counter-pair",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "uint64-wrap-with-saturating-wrap-count",
      "synchronization": "allocator-boundary-accounting-published-in-coherent-snapshot",
      "availability": "bad-no-data-before-first-snapshot; never-infer-zero",
      "implementationTask": "T2"
    },
    {
      "id": "psram_gauges",
      "scope": "device-snapshot",
      "metrics": ["PSRAM.Ready", "PSRAM.TotalBytes", "PSRAM.UsedBytes", "PSRAM.PeakUsedBytes", "PSRAM.FreeBytes", "PSRAM.LargestFreeBlockBytes", "PSRAM.RequestedBytesInUse", "PSRAM.PeakRequestedBytesInUse", "PSRAM.AllocatorMode", "PSRAM.LastFailedRequestedBytes", "PSRAM.LastFailureReason", "PSRAM.LastFailureReasonText", "PSRAM.LastFailureTimestamp", "PSRAM.LastFailureUptimeMs"],
      "owner": "psram_allocator-provider/diag_service",
      "unit": "mixed",
      "unitByMetric": {"PSRAM.Ready": "boolean", "PSRAM.TotalBytes": "bytes", "PSRAM.UsedBytes": "bytes", "PSRAM.PeakUsedBytes": "bytes", "PSRAM.FreeBytes": "bytes", "PSRAM.LargestFreeBlockBytes": "bytes", "PSRAM.RequestedBytesInUse": "bytes", "PSRAM.PeakRequestedBytesInUse": "bytes", "PSRAM.AllocatorMode": "text", "PSRAM.LastFailedRequestedBytes": "bytes", "PSRAM.LastFailureReason": "enum", "PSRAM.LastFailureReasonText": "text", "PSRAM.LastFailureTimestamp": "utc-datetime", "PSRAM.LastFailureUptimeMs": "milliseconds"},
      "kind": "gauge",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "checked-conversion-or-failed",
      "synchronization": "allocator-mutex-snapshot-consumed-by-diag-service",
      "availability": "not-compiled=bad-not-supported; init-failed=bad-not-connected; stale=uncertain-last-usable",
      "implementationTask": "T2"
    },
    {
      "id": "psram_counters",
      "scope": "device-snapshot",
      "metrics": ["PSRAM.SuccessfulAllocations", "PSRAM.SuccessfulAllocationsWrapCount", "PSRAM.SuccessfulFrees", "PSRAM.SuccessfulFreesWrapCount", "PSRAM.FailedAllocations", "PSRAM.FailedAllocationsWrapCount", "PSRAM.LockTimeouts", "PSRAM.LockTimeoutsWrapCount", "PSRAM.InvalidContextFailures", "PSRAM.InvalidContextFailuresWrapCount"],
      "owner": "psram_allocator-provider/diag_service",
      "unit": "operations",
      "kind": "wrapping-counter-pair",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "uint64-wrap-with-saturating-wrap-count",
      "synchronization": "allocator-boundary-accounting-published-in-coherent-snapshot",
      "availability": "unsupported-and-disconnected-remain-distinct-from-zero",
      "implementationTask": "T2"
    },
    {
      "id": "lwip_arena",
      "scope": "device-snapshot",
      "metrics": ["PSRAM.LwIP.ReservedBytes", "PSRAM.LwIP.UsedBytes", "PSRAM.LwIP.PeakUsedBytes", "PSRAM.LwIP.LargestFreeBlockBytes"],
      "owner": "lwip_psram_heap-provider/diag_service",
      "unit": "bytes",
      "kind": "gauge",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "checked-conversion-or-failed",
      "synchronization": "lwip-arena-provider-snapshot-at-one-second-cadence",
      "availability": "unsupported-stats-are-bad-not-supported-never-zero",
      "implementationTask": "T2"
    },
    {
      "id": "lwip_counters",
      "scope": "device-snapshot",
      "metrics": ["PSRAM.LwIP.FailedAllocations", "PSRAM.LwIP.FailedAllocationsWrapCount"],
      "owner": "lwip_psram_heap-provider/diag_service",
      "unit": "operations",
      "kind": "wrapping-counter-pair",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "uint64-wrap-with-saturating-wrap-count",
      "synchronization": "lwip-allocation-boundary-accounting",
      "availability": "unsupported-stats-are-bad-not-supported-never-zero",
      "implementationTask": "T2"
    },
    {
      "id": "snapshot_identity",
      "scope": "device-snapshot",
      "metrics": ["SnapshotSequence", "SnapshotSequenceWrapCount", "SnapshotTimestamp", "SnapshotAgeMs", "TaskCount", "TaskListTruncated", "TaskNameConflict", "TaskModelIncomplete"],
      "owner": "diag_service",
      "unit": "mixed",
      "unitByMetric": {"SnapshotSequence": "samples", "SnapshotSequenceWrapCount": "wraps", "SnapshotTimestamp": "utc-datetime", "SnapshotAgeMs": "milliseconds", "TaskCount": "tasks", "TaskListTruncated": "boolean", "TaskNameConflict": "boolean", "TaskModelIncomplete": "boolean"},
      "kind": "snapshot-metadata",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "sequence-is-uint64-wrap-with-saturating-wrap-count",
      "synchronization": "bounded-double-buffer-atomic-publication",
      "availability": "wall-timestamp-null-until-valid; monotonic-age-remains-available",
      "implementationTask": "T2"
    },
    {
      "id": "task_identity_and_state",
      "scope": "per-task-generation",
      "metrics": ["Task.Present", "Task.Name", "Task.TaskNumber", "Task.Generation", "Task.GenerationWrapCount", "Task.State", "Task.StateText", "Task.CurrentPriority", "Task.BasePriority", "Task.StackHighWatermarkBytes"],
      "owner": "diag_service/task-lifecycle-and-system-state-provider",
      "unit": "mixed",
      "unitByMetric": {"Task.Present": "boolean", "Task.Name": "text", "Task.TaskNumber": "identifier", "Task.Generation": "generations", "Task.GenerationWrapCount": "wraps", "Task.State": "enum", "Task.StateText": "text", "Task.CurrentPriority": "priority", "Task.BasePriority": "priority", "Task.StackHighWatermarkBytes": "bytes"},
      "kind": "gauge",
      "lifetime": "boot-retained-name-and-generation",
      "reset": "reboot-only",
      "overflow": "generation-is-uint64-wrap-with-saturating-wrap-count",
      "synchronization": "trace-hook-ingress-plus-complete-system-state-snapshot",
      "availability": "deleted-task-nonidentity-fields-are-bad-no-data; incomplete-sample-is-uncertain-last-usable",
      "implementationTask": "T2"
    },
    {
      "id": "task_runtime",
      "scope": "per-task-generation",
      "metrics": ["Task.RuntimeCounterMs", "Task.RuntimeCounterWrapCount", "Task.RuntimePercent"],
      "owner": "diag_service/task-system-state-provider",
      "unit": "mixed",
      "unitByMetric": {"Task.RuntimeCounterMs": "milliseconds", "Task.RuntimeCounterWrapCount": "wraps", "Task.RuntimePercent": "percent"},
      "kind": "extended-counter-and-derived-distribution-input",
      "lifetime": "task-generation",
      "reset": "task-recreation-or-reboot",
      "overflow": "native-uint32-modulo-extended-to-uint64; published-counter-wrap-count-saturates",
      "synchronization": "successive-complete-one-second-snapshots-of-same-generation",
      "availability": "first-gap-zero-total-truncated-deleted-or-unprovable-wrap-is-bad-no-data-or-uncertain",
      "implementationTask": "T2"
    },
    {
      "id": "opcua_occupancy",
      "scope": "server-lifetime",
      "metrics": ["OpcUa.Sessions.Current", "OpcUa.Sessions.Peak", "OpcUa.Sessions.Capacity", "OpcUa.SecureChannels.Current", "OpcUa.SecureChannels.Peak", "OpcUa.SecureChannels.Capacity", "OpcUa.Subscriptions.Current", "OpcUa.Subscriptions.Peak", "OpcUa.Subscriptions.Capacity", "OpcUa.MonitoredItems.Current", "OpcUa.MonitoredItems.Peak", "OpcUa.MonitoredItems.Capacity", "OpcUa.PublishRequests.Current", "OpcUa.PublishRequests.Peak", "OpcUa.PublishRequests.Capacity", "OpcUa.EventQueue.Current", "OpcUa.EventQueue.Peak", "OpcUa.EventQueue.Capacity"],
      "owner": "opcua-resource-service/open62541-adapter",
      "unit": "objects",
      "kind": "gauge",
      "lifetime": "server-lifetime-with-boot-lifetime-peak-policy-recorded",
      "reset": "server-rebuild-current-resets; boot-cumulative-policy-must-be-explicit",
      "overflow": "checked-capacity-and-counter-conversion-or-failed",
      "synchronization": "OpcUaTask-mutation-with-coherent-diag-service-publication",
      "availability": "callback-or-owner-not-observable-is-bad-not-supported-never-inferred",
      "implementationTask": "T3"
    },
    {
      "id": "opcua_rejections",
      "scope": "boot",
      "metrics": ["OpcUa.RejectedRequests", "OpcUa.RejectedRequestsWrapCount", "OpcUa.EventQueueDrops", "OpcUa.EventQueueDropsWrapCount"],
      "owner": "opcua-resource-service/open62541-adapter",
      "unit": "operations",
      "kind": "wrapping-counter-pair",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "uint64-wrap-with-saturating-wrap-count",
      "synchronization": "record-at-definitive-open62541-rejection-or-drop-site",
      "availability": "unobservable-categories-are-bad-not-supported-not-zero",
      "implementationTask": "T3"
    },
    {
      "id": "legacy_diagnostic_views",
      "scope": "opcua-compatibility-view",
      "metrics": ["Legacy.FreeHeap", "Legacy.MinEverFreeHeap", "Legacy.Task.OPC.StackHighWatermark", "Legacy.Task.SPI.StackHighWatermark", "Legacy.Task.TEMP.StackHighWatermark"],
      "owner": "opcua-diagnostic-adapter-over-diag-service-snapshot",
      "unit": "mixed",
      "unitByMetric": {"Legacy.FreeHeap": "bytes", "Legacy.MinEverFreeHeap": "bytes", "Legacy.Task.OPC.StackHighWatermark": "StackType_t-words", "Legacy.Task.SPI.StackHighWatermark": "StackType_t-words", "Legacy.Task.TEMP.StackHighWatermark": "StackType_t-words"},
      "kind": "compatibility-gauge",
      "lifetime": "boot",
      "reset": "reboot-only",
      "overflow": "preserve-existing-UInt32-type-and-deterministic-conversion",
      "synchronization": "same-coherent-snapshot-as-new-resource-diagnostics",
      "availability": "preserve-existing-nodeids-browsenames-types-units-and-permissions",
      "implementationTask": "T2"
    },
    {
      "id": "latency",
      "scope": "benchmark-run",
      "metrics": ["StartupLatencyMs", "SecureSessionEstablishmentLatencyMs", "ReadLatencyMs", "WriteLatencyMs", "MethodLatencyMs", "HistoryReadLatencyMs", "EventDeliveryLatencyMs"],
      "owner": "benchmark-client-and-device-timestamp-hooks",
      "unit": "milliseconds",
      "kind": "distribution",
      "lifetime": "run",
      "reset": "each-run",
      "overflow": "sample-overflow-fails-run-no-silent-drop",
      "synchronization": "host-monotonic-intervals; event-correlation-requires-valid-source-time",
      "availability": "report-count-p50-p95-p99-max-or-explicit-state-with-reason",
      "implementationTask": "T5"
    },
    {
      "id": "sampling_jitter",
      "scope": "benchmark-run-per-channel",
      "metrics": ["SamplingIntervalMs", "SamplingJitterMs"],
      "owner": "sensor-runtime-hook-and-benchmark-report",
      "unit": "milliseconds",
      "kind": "distribution",
      "lifetime": "run",
      "reset": "each-run",
      "overflow": "sample-overflow-fails-run-no-silent-drop",
      "synchronization": "device-monotonic-sample-timestamps",
      "availability": "requires-at-least-two-correlated-samples-otherwise-unavailable",
      "implementationTask": "T5"
    }
  ],
  "benchmarkMatrix": {
    "profileIdTemplate": "v052-syn-c{channels}-ns0{namespaceZero}-sec{security}-cl{clients}-hz{rateHz}-ev{events}-hist{history}",
    "axes": {
      "channels": [1, 4, 8, 16],
      "namespaceZero": ["full"],
      "security": ["basic256sha256-signandencrypt", "test-none"],
      "clients": [1, 2, 4],
      "rateHz": [1, 10],
      "events": [false, true],
      "history": [false, true]
    },
    "implementationStatus": {
      "full": "implemented-by-current-amalgamation",
      "basic256sha256-signandencrypt": "implemented-production-default",
      "test-none": "planned-T4-explicit-test-only-profile",
      "synthetic-channel-profiles": "planned-T4-no-persisted-preset-id",
      "latency-and-jitter-execution": "planned-T5",
      "hardware-baseline-execution": "planned-T6"
    },
    "unsupported": [
      {
        "axis": "namespaceZero",
        "value": "reduced",
        "reason": "bundled-open62541-amalgamation-is-UA_GENERATED_NAMESPACE_ZERO_FULL-and-has-no-first-party-selector"
      }
    ],
    "rules": [
      "test-none-is-never-a-production-default-or-production-artifact",
      "every-channel-profile-uses-the-synthetic-driver-and-explicit-settings-not-dev_benchmark",
      "a-16-channel-profile-must-prove-independent-per-channel-context-despite-eight-valid-source-index-values",
      "every-supported-cell-is-executed-on-reference-hardware-or-reported-not-run-with-a-reason",
      "host-or-mock-results-never-substitute-for-runtime-hardware-metrics"
    ]
  }
}
