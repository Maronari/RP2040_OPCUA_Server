include_guard(GLOBAL)

if(NOT DEFINED PICO_FLASH_SIZE_BYTES)
    message(FATAL_ERROR "OTA layout requires PICO_FLASH_SIZE_BYTES from the board configuration")
endif()

set(OTA_FLASH_XIP_BASE 0x10000000)
if(PICO_PLATFORM MATCHES "^rp2350")
    set(OTA_PICO_CRT0_FAMILY rp2350)
elseif(PICO_PLATFORM MATCHES "^rp2040")
    set(OTA_PICO_CRT0_FAMILY rp2040)
else()
    message(FATAL_ERROR "Unsupported PICO_PLATFORM for OTA layout: ${PICO_PLATFORM}")
endif()
set(OTA_FLASH_ERASE_SIZE_BYTES 4096 CACHE STRING "Flash sector size for OTA")
set(OTA_FLASH_PROGRAM_SIZE_BYTES 256 CACHE STRING "Flash program size for OTA")
set(OTA_BOOT2_RESERVED_SIZE_BYTES 256 CACHE STRING "Reserved boot2 bytes")
set(OTA_BOOTLOADER_SIZE_BYTES 65536 CACHE STRING "Bootloader region size")
set(OTA_MAINTENANCE_JOURNAL_SIZE_BYTES 32768 CACHE STRING "Reserved maintenance journal size")
set(OTA_CONFIG_SLOT_SIZE_BYTES 65536 CACHE STRING "Reserved persistent config slot size")
set(OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES 65536 CACHE STRING "Reserved device identity slot size")
set(OTA_SECURITY_TRUST_SLOT_SIZE_BYTES 65536 CACHE STRING "Reserved trust list slot size")
set(OTA_SECURITY_STATE_SIZE_BYTES 65536 CACHE STRING "Reserved security lifecycle state region size")
set(OTA_STATE_SIZE_BYTES 65536 CACHE STRING "Reserved OTA state region size")

function(_ota_require_aligned name value alignment)
    math(EXPR _rem "${value} % ${alignment}")
    if(NOT _rem EQUAL 0)
        message(FATAL_ERROR "${name}=${value} must be aligned to ${alignment} bytes")
    endif()
endfunction()

math(EXPR OTA_FLASH_TOTAL_BYTES "${PICO_FLASH_SIZE_BYTES}")
math(EXPR OTA_LAYOUT_RESERVED_BYTES
     "${OTA_BOOTLOADER_SIZE_BYTES} + ${OTA_MAINTENANCE_JOURNAL_SIZE_BYTES} + (2 * ${OTA_CONFIG_SLOT_SIZE_BYTES}) + (2 * ${OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES}) + (2 * ${OTA_SECURITY_TRUST_SLOT_SIZE_BYTES}) + ${OTA_SECURITY_STATE_SIZE_BYTES} + ${OTA_STATE_SIZE_BYTES}")
math(EXPR OTA_BANK_REGION_BYTES "${OTA_FLASH_TOTAL_BYTES} - ${OTA_LAYOUT_RESERVED_BYTES}")
math(EXPR OTA_BANK_SIZE_BYTES "${OTA_BANK_REGION_BYTES} / 2")
math(EXPR OTA_BANK_REMAINDER "${OTA_BANK_REGION_BYTES} % 2")

if(OTA_LAYOUT_RESERVED_BYTES GREATER_EQUAL OTA_FLASH_TOTAL_BYTES)
    message(FATAL_ERROR "OTA reserved regions exceed flash size")
endif()
if(NOT OTA_BANK_REMAINDER EQUAL 0)
    message(FATAL_ERROR "OTA bank region must split evenly into two banks")
endif()
if(OTA_BOOTLOADER_SIZE_BYTES LESS OTA_BOOT2_RESERVED_SIZE_BYTES)
    message(FATAL_ERROR "Bootloader region must include boot2 reservation")
endif()

_ota_require_aligned("OTA_BOOTLOADER_SIZE_BYTES" "${OTA_BOOTLOADER_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_MAINTENANCE_JOURNAL_SIZE_BYTES" "${OTA_MAINTENANCE_JOURNAL_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_CONFIG_SLOT_SIZE_BYTES" "${OTA_CONFIG_SLOT_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES" "${OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_SECURITY_TRUST_SLOT_SIZE_BYTES" "${OTA_SECURITY_TRUST_SLOT_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_SECURITY_STATE_SIZE_BYTES" "${OTA_SECURITY_STATE_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_STATE_SIZE_BYTES" "${OTA_STATE_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")
_ota_require_aligned("OTA_BANK_SIZE_BYTES" "${OTA_BANK_SIZE_BYTES}" "${OTA_FLASH_ERASE_SIZE_BYTES}")

math(EXPR OTA_BOOTLOADER_OFFSET_BYTES "0")
math(EXPR OTA_BANK_A_OFFSET_BYTES "${OTA_BOOTLOADER_SIZE_BYTES}")
math(EXPR OTA_BANK_B_OFFSET_BYTES "${OTA_BANK_A_OFFSET_BYTES} + ${OTA_BANK_SIZE_BYTES}")
math(EXPR OTA_MAINTENANCE_JOURNAL_OFFSET_BYTES "${OTA_BANK_B_OFFSET_BYTES} + ${OTA_BANK_SIZE_BYTES}")
math(EXPR OTA_CONFIG_SLOT_0_OFFSET_BYTES "${OTA_MAINTENANCE_JOURNAL_OFFSET_BYTES} + ${OTA_MAINTENANCE_JOURNAL_SIZE_BYTES}")
math(EXPR OTA_CONFIG_SLOT_1_OFFSET_BYTES "${OTA_CONFIG_SLOT_0_OFFSET_BYTES} + ${OTA_CONFIG_SLOT_SIZE_BYTES}")
math(EXPR OTA_SECURITY_IDENTITY_SLOT_0_OFFSET_BYTES "${OTA_CONFIG_SLOT_1_OFFSET_BYTES} + ${OTA_CONFIG_SLOT_SIZE_BYTES}")
math(EXPR OTA_SECURITY_IDENTITY_SLOT_1_OFFSET_BYTES "${OTA_SECURITY_IDENTITY_SLOT_0_OFFSET_BYTES} + ${OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES}")
math(EXPR OTA_SECURITY_TRUST_SLOT_0_OFFSET_BYTES "${OTA_SECURITY_IDENTITY_SLOT_1_OFFSET_BYTES} + ${OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES}")
math(EXPR OTA_SECURITY_TRUST_SLOT_1_OFFSET_BYTES "${OTA_SECURITY_TRUST_SLOT_0_OFFSET_BYTES} + ${OTA_SECURITY_TRUST_SLOT_SIZE_BYTES}")
math(EXPR OTA_SECURITY_STATE_OFFSET_BYTES "${OTA_SECURITY_TRUST_SLOT_1_OFFSET_BYTES} + ${OTA_SECURITY_TRUST_SLOT_SIZE_BYTES}")
math(EXPR OTA_STATE_OFFSET_BYTES "${OTA_SECURITY_STATE_OFFSET_BYTES} + ${OTA_SECURITY_STATE_SIZE_BYTES}")

math(EXPR OTA_BOOTLOADER_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_BOOTLOADER_OFFSET_BYTES}")
math(EXPR OTA_BANK_A_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_BANK_A_OFFSET_BYTES}")
math(EXPR OTA_BANK_B_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_BANK_B_OFFSET_BYTES}")
math(EXPR OTA_MAINTENANCE_JOURNAL_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_MAINTENANCE_JOURNAL_OFFSET_BYTES}")
math(EXPR OTA_CONFIG_SLOT_0_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_CONFIG_SLOT_0_OFFSET_BYTES}")
math(EXPR OTA_CONFIG_SLOT_1_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_CONFIG_SLOT_1_OFFSET_BYTES}")
math(EXPR OTA_SECURITY_IDENTITY_SLOT_0_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_SECURITY_IDENTITY_SLOT_0_OFFSET_BYTES}")
math(EXPR OTA_SECURITY_IDENTITY_SLOT_1_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_SECURITY_IDENTITY_SLOT_1_OFFSET_BYTES}")
math(EXPR OTA_SECURITY_TRUST_SLOT_0_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_SECURITY_TRUST_SLOT_0_OFFSET_BYTES}")
math(EXPR OTA_SECURITY_TRUST_SLOT_1_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_SECURITY_TRUST_SLOT_1_OFFSET_BYTES}")
math(EXPR OTA_SECURITY_STATE_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_SECURITY_STATE_OFFSET_BYTES}")
math(EXPR OTA_STATE_ORIGIN "${OTA_FLASH_XIP_BASE} + ${OTA_STATE_OFFSET_BYTES}")
math(EXPR OTA_FLASH_END_ADDRESS "${OTA_FLASH_XIP_BASE} + ${OTA_FLASH_TOTAL_BYTES}")

math(EXPR OTA_LAYOUT_END_OFFSET_BYTES "${OTA_STATE_OFFSET_BYTES} + ${OTA_STATE_SIZE_BYTES}")
if(NOT OTA_LAYOUT_END_OFFSET_BYTES EQUAL OTA_FLASH_TOTAL_BYTES)
    message(FATAL_ERROR "OTA layout must cover flash exactly")
endif()

foreach(_v OTA_FLASH_XIP_BASE OTA_FLASH_TOTAL_BYTES OTA_FLASH_END_ADDRESS OTA_FLASH_ERASE_SIZE_BYTES OTA_FLASH_PROGRAM_SIZE_BYTES OTA_BOOT2_RESERVED_SIZE_BYTES OTA_BOOTLOADER_OFFSET_BYTES OTA_BOOTLOADER_ORIGIN OTA_BOOTLOADER_SIZE_BYTES OTA_BANK_A_OFFSET_BYTES OTA_BANK_A_ORIGIN OTA_BANK_B_OFFSET_BYTES OTA_BANK_B_ORIGIN OTA_BANK_SIZE_BYTES OTA_MAINTENANCE_JOURNAL_OFFSET_BYTES OTA_MAINTENANCE_JOURNAL_ORIGIN OTA_MAINTENANCE_JOURNAL_SIZE_BYTES OTA_CONFIG_SLOT_SIZE_BYTES OTA_CONFIG_SLOT_0_OFFSET_BYTES OTA_CONFIG_SLOT_0_ORIGIN OTA_CONFIG_SLOT_1_OFFSET_BYTES OTA_CONFIG_SLOT_1_ORIGIN OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES OTA_SECURITY_IDENTITY_SLOT_0_OFFSET_BYTES OTA_SECURITY_IDENTITY_SLOT_0_ORIGIN OTA_SECURITY_IDENTITY_SLOT_1_OFFSET_BYTES OTA_SECURITY_IDENTITY_SLOT_1_ORIGIN OTA_SECURITY_TRUST_SLOT_SIZE_BYTES OTA_SECURITY_TRUST_SLOT_0_OFFSET_BYTES OTA_SECURITY_TRUST_SLOT_0_ORIGIN OTA_SECURITY_TRUST_SLOT_1_OFFSET_BYTES OTA_SECURITY_TRUST_SLOT_1_ORIGIN OTA_SECURITY_STATE_OFFSET_BYTES OTA_SECURITY_STATE_ORIGIN OTA_SECURITY_STATE_SIZE_BYTES OTA_STATE_OFFSET_BYTES OTA_STATE_ORIGIN OTA_STATE_SIZE_BYTES)
    math(EXPR ${_v}_HEX "${${_v}}" OUTPUT_FORMAT HEXADECIMAL)
endforeach()

set(OTA_LAYOUT_GENERATED_DIR "${CMAKE_BINARY_DIR}/generated/ota_layout")
file(MAKE_DIRECTORY "${OTA_LAYOUT_GENERATED_DIR}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/ota_layout.h.in" "${OTA_LAYOUT_GENERATED_DIR}/ota_layout.h" @ONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/ota_layout.json.in" "${OTA_LAYOUT_GENERATED_DIR}/ota_layout.json" @ONLY)

set(OTA_FLASH_REGION_ORIGIN_HEX "${OTA_BANK_A_ORIGIN_HEX}")
set(OTA_FLASH_REGION_LENGTH_HEX "${OTA_BANK_SIZE_BYTES_HEX}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/ota_flash_region.ld.in" "${OTA_LAYOUT_GENERATED_DIR}/ota_flash_region_app.ld" @ONLY)

set(OTA_FLASH_REGION_ORIGIN_HEX "${OTA_BOOTLOADER_ORIGIN_HEX}")
set(OTA_FLASH_REGION_LENGTH_HEX "${OTA_BOOTLOADER_SIZE_BYTES_HEX}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/ota_flash_region.ld.in" "${OTA_LAYOUT_GENERATED_DIR}/ota_flash_region_bootloader.ld" @ONLY)

set(_sdk_memmap "${PICO_SDK_PATH}/src/rp2_common/pico_crt0/${OTA_PICO_CRT0_FAMILY}/memmap_default.ld")
if(NOT EXISTS "${_sdk_memmap}")
    message(FATAL_ERROR "Unable to locate SDK memmap template: ${_sdk_memmap}")
endif()
file(READ "${_sdk_memmap}" _sdk_memmap_text)
string(REPLACE "INCLUDE \"pico_flash_region.ld\"" "INCLUDE \"${OTA_LAYOUT_GENERATED_DIR}/ota_flash_region_app.ld\"" _app_memmap_text "${_sdk_memmap_text}")
string(REPLACE "INCLUDE \"pico_flash_region.ld\"" "INCLUDE \"${OTA_LAYOUT_GENERATED_DIR}/ota_flash_region_bootloader.ld\"" _boot_memmap_text "${_sdk_memmap_text}")
file(WRITE "${OTA_LAYOUT_GENERATED_DIR}/app_bank_a_memmap.ld" "${_app_memmap_text}")
file(WRITE "${OTA_LAYOUT_GENERATED_DIR}/bootloader_memmap.ld" "${_boot_memmap_text}")

function(ota_layout_apply_to_target target_name)
    target_include_directories(${target_name} PRIVATE "${OTA_LAYOUT_GENERATED_DIR}")
endfunction()

function(ota_layout_set_app_bank_a_linker_script target_name)
    pico_set_linker_script(${target_name} "${OTA_LAYOUT_GENERATED_DIR}/app_bank_a_memmap.ld")
endfunction()

function(ota_layout_set_bootloader_linker_script target_name)
    pico_set_linker_script(${target_name} "${OTA_LAYOUT_GENERATED_DIR}/bootloader_memmap.ld")
endfunction()
