{
  "board": "@PICO_BOARD@",
  "platform": "@PICO_PLATFORM@",
  "firmware": {
    "version": "@RP2_FIRMWARE_VERSION@",
    "version_number": @RP2_FIRMWARE_VERSION_NUMBER@
  },
  "flash": {
    "xip_base": "@OTA_FLASH_XIP_BASE_HEX@",
    "size_bytes": @OTA_FLASH_TOTAL_BYTES@,
    "size_hex": "@OTA_FLASH_TOTAL_BYTES_HEX@",
    "end_address": "@OTA_FLASH_END_ADDRESS_HEX@"
  },
  "constraints": {
    "erase_size_bytes": @OTA_FLASH_ERASE_SIZE_BYTES@,
    "program_size_bytes": @OTA_FLASH_PROGRAM_SIZE_BYTES@,
    "boot2_reserved_size_bytes": @OTA_BOOT2_RESERVED_SIZE_BYTES@
  },
  "regions": {
    "bootloader": {
      "origin": "@OTA_BOOTLOADER_ORIGIN_HEX@",
      "offset_bytes": @OTA_BOOTLOADER_OFFSET_BYTES@,
      "size_bytes": @OTA_BOOTLOADER_SIZE_BYTES@
    },
    "bank_a": {
      "origin": "@OTA_BANK_A_ORIGIN_HEX@",
      "offset_bytes": @OTA_BANK_A_OFFSET_BYTES@,
      "size_bytes": @OTA_BANK_SIZE_BYTES@
    },
    "bank_b": {
      "origin": "@OTA_BANK_B_ORIGIN_HEX@",
      "offset_bytes": @OTA_BANK_B_OFFSET_BYTES@,
      "size_bytes": @OTA_BANK_SIZE_BYTES@
    },
    "maintenance_journal": {
      "origin": "@OTA_MAINTENANCE_JOURNAL_ORIGIN_HEX@",
      "offset_bytes": @OTA_MAINTENANCE_JOURNAL_OFFSET_BYTES@,
      "size_bytes": @OTA_MAINTENANCE_JOURNAL_SIZE_BYTES@
    },
    "history": {
      "origin": "@OTA_HISTORY_ORIGIN_HEX@",
      "offset_bytes": @OTA_HISTORY_OFFSET_BYTES@,
      "size_bytes": @OTA_HISTORY_SIZE_BYTES@
    },
    "config_slot_0": {
      "origin": "@OTA_CONFIG_SLOT_0_ORIGIN_HEX@",
      "offset_bytes": @OTA_CONFIG_SLOT_0_OFFSET_BYTES@,
      "size_bytes": @OTA_CONFIG_SLOT_SIZE_BYTES@
    },
    "config_slot_1": {
      "origin": "@OTA_CONFIG_SLOT_1_ORIGIN_HEX@",
      "offset_bytes": @OTA_CONFIG_SLOT_1_OFFSET_BYTES@,
      "size_bytes": @OTA_CONFIG_SLOT_SIZE_BYTES@
    },
    "security_identity_slot_0": {
      "origin": "@OTA_SECURITY_IDENTITY_SLOT_0_ORIGIN_HEX@",
      "offset_bytes": @OTA_SECURITY_IDENTITY_SLOT_0_OFFSET_BYTES@,
      "size_bytes": @OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES@
    },
    "security_identity_slot_1": {
      "origin": "@OTA_SECURITY_IDENTITY_SLOT_1_ORIGIN_HEX@",
      "offset_bytes": @OTA_SECURITY_IDENTITY_SLOT_1_OFFSET_BYTES@,
      "size_bytes": @OTA_SECURITY_IDENTITY_SLOT_SIZE_BYTES@
    },
    "security_trust_slot_0": {
      "origin": "@OTA_SECURITY_TRUST_SLOT_0_ORIGIN_HEX@",
      "offset_bytes": @OTA_SECURITY_TRUST_SLOT_0_OFFSET_BYTES@,
      "size_bytes": @OTA_SECURITY_TRUST_SLOT_SIZE_BYTES@
    },
    "security_trust_slot_1": {
      "origin": "@OTA_SECURITY_TRUST_SLOT_1_ORIGIN_HEX@",
      "offset_bytes": @OTA_SECURITY_TRUST_SLOT_1_OFFSET_BYTES@,
      "size_bytes": @OTA_SECURITY_TRUST_SLOT_SIZE_BYTES@
    },
    "security_state": {
      "origin": "@OTA_SECURITY_STATE_ORIGIN_HEX@",
      "offset_bytes": @OTA_SECURITY_STATE_OFFSET_BYTES@,
      "size_bytes": @OTA_SECURITY_STATE_SIZE_BYTES@
    },
    "state": {
      "origin": "@OTA_STATE_ORIGIN_HEX@",
      "offset_bytes": @OTA_STATE_OFFSET_BYTES@,
      "size_bytes": @OTA_STATE_SIZE_BYTES@
    }
  }
}
