{
  "profileSchemaVersion": 1,
  "profileId": "@RP2_BENCHMARK_PROFILE_ID@",
  "firmwareVersion": "@DEVICE_PROFILE_FW_REVISION@",
  "buildGitHash": "@DEVICE_PROFILE_GIT_HASH@",
  "buildTime": "@DEVICE_PROFILE_BUILD_TIME@",
  "board": "@PICO_BOARD@",
  "driverPack": "@FIRMWARE_DRIVER_PACK@",
  "namespaceZero": "full",
  "security": "@FIRMWARE_BENCHMARK_SECURITY@",
  "channels": @FIRMWARE_BENCHMARK_CHANNELS@,
  "rateHz": @FIRMWARE_BENCHMARK_RATE_HZ@,
  "clients": @FIRMWARE_BENCHMARK_CLIENTS@,
  "events": @RP2_BENCHMARK_EVENTS_JSON@,
  "history": @RP2_BENCHMARK_HISTORY_JSON@,
  "testOnly": true,
  "hardwareState": "not-run",
  "clientCountMeaning": "declared external workload; not automatically launched",
  "configuredCapacities": {"sessions": 4, "secureChannels": 4, "subscriptions": 4, "monitoredItems": 128, "publishRequestsPerSession": 4}
}
